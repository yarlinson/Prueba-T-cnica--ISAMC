						"description": "Elimina una tarea del sistema. Reemplaza el ID 1 con el ID de la tarea que deseas eliminar."
					},
					"response": []
				}
			],
			"description": "Endpoints para el CRUD completo de Tareas"
		}
	],
	"variable": [
		{
			"key": "base_url",
