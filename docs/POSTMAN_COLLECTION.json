					"name": "Crear tarea",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"persona\": 1,\n    \"titulo\": \"Revisar documentación fiscal\",\n    \"descripcion\": \"Verificar y actualizar todos los documentos fiscales de la empresa\",\n    \"fecha_limite\": \"2025-12-31\",\n    \"completada\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/tareas/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"tareas",
								""
							]
						},
						"description": "Crea una nueva tarea asociada a una persona. El campo 'persona' debe ser el ID de una persona existente."
					},
					"response": []
				},
				{
					"name": "Actualizar tarea",
